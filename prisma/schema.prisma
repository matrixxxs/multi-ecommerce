generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id              String                  @unique @db.Uuid
  email                 String                  @unique @db.VarChar(255)
  password              String                  @db.VarChar(255)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  stores                stores                  @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  password_reset_tokens password_reset_tokens[]
}

model orders {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id         String    @db.Uuid
  customer_name    String    @db.VarChar(255)
  customer_address String    @db.VarChar(255)
  customer_phone   String    @db.VarChar(255)
  total            Decimal   @db.Decimal(10, 2)
  items            Json
  status           String    @default("pending")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  stores           stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id, status], map: "idx_orders_status")
  @@index([store_id], map: "idx_orders_store")
}

model password_reset_tokens {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String      @db.Uuid
  token       String
  expires_at  DateTime    @default(dbgenerated("(now() + '01:00:00'::interval)")) @db.Timestamptz(6)
  used        Boolean?    @default(false)
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  admin_users admin_users @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model products {
  id              String    @id(map: "product_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id        String    @db.Uuid
  name            String    @db.VarChar(255)
  description     String    @db.VarChar(255)
  price           Decimal   @db.Decimal(10, 2)
  category        String    @db.VarChar(255)
  image_url       String
  in_stock        Boolean   @default(true)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  image_public_id String?
  is_deleted      Boolean?  @default(false)
  deleted_at      DateTime? @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  stores          stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_store_id_fkey")

  @@index([store_id], map: "idx_product_store")
}

model stores {
  id           String       @id(map: "store_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @db.VarChar(100)
  slug         String       @db.VarChar(100)
  phone_number String?
  logo_url     String?
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  admin_users  admin_users?
  orders       orders[]
  products     products[]
}
